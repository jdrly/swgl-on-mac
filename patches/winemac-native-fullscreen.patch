+    /* NativeFullscreen: the screen this window should have a Space on, if
+       any.  That is a visible top-level window covering a whole screen, the
+       way a Direct3D full-screen window or a borderless "windowed full
+       screen" game window does. */
+    - (NSScreen*) screenForNativeFullscreen
+    {
+        NSRect contentRect;
+        NSScreen* screen;
+
+        if (!native_fullscreen) return nil;
+        if (self.parentWindow || self.latentParentWindow) return nil;
+        if (self.disabled || self.noForeground || maximized || closing) return nil;
+        if (![self isVisible] || [self isMiniaturized]) return nil;
+        /* A real display mode switch captures the displays and puts the
+           window above the capture shield; a Space adds nothing there. */
+        if ([[WineApplicationController sharedController] areDisplaysCaptured]) return nil;
+
+        /* In a Space AppKit owns the frame, so go by what Wine asked for. */
+        if ([self styleMask] & NSWindowStyleMaskFullScreen)
+            contentRect = wineRequestedContentRect;
+        else
+            contentRect = [self contentRectForFrameRect:self.wine_fractionalFrame];
+        if (!(screen = screen_covered_by_rect(contentRect, [NSScreen screens]))) return nil;
+        /* Exactly one screen: a window spanning several would shrink to one. */
+        if (!NSContainsRect(NSInsetRect([screen frame], -1, -1), contentRect)) return nil;
+
+        /* AppKit keeps a full-screen window below the camera housing of a
+           notched display, which would make the window smaller than the
+           display mode the game set.  Stay with the Dock and menu bar hidden
+           there. */
+        if (screen.safeAreaInsets.top > 0) return nil;
+
+        return screen;
+    }
