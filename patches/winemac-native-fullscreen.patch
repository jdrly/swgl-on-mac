+    /* Coalesce: Direct3D changes the style, then the frame, and a game may
+       recreate or move its window more than once while it starts. */
+    - (void) scheduleNativeFullscreenUpdate
+    {
+        if (!native_fullscreen) return;
+        [NSObject cancelPreviousPerformRequestsWithTarget:self
+                                                 selector:@selector(updateNativeFullscreen)
+                                                   object:nil];
+        [self performSelector:@selector(updateNativeFullscreen) withObject:nil afterDelay:0.25];
+    }
+
+    - (void) updateNativeFullscreen
+    {
+        BOOL inSpace = ([self styleMask] & NSWindowStyleMaskFullScreen) != 0;
+        BOOL wants;
+
+        /* windowDid{Enter,Exit}FullScreen look again. */
+        if (enteringFullScreen || exitingFullScreen) return;
+
+        wants = [self wantsNativeFullscreen];
+        if (!wants && !inSpace)
+            nativeFullscreenDeclined = FALSE;
+
+        if (!inSpace)
+        {
+            /* Only for the active app: entering a Space switches to it. */
+            if (wants && !nativeFullscreenDeclined && [NSApp isActive] &&
+                [[NSProcessInfo processInfo] systemUptime] - nativeFullscreenFailedTime > 2.0)
+            {
+                ERR(@"NativeFullscreen: entering a Space for %@\n", self);
+                nativeFullscreenAuto = TRUE;
+                [self adjustFullScreenBehavior:[self collectionBehavior]];
+                /* Direct3D made it topmost (floating); a full-screen window
+                   starts from the normal level.  The level pass after the
+                   transition (or a failure) sets it again. */
+                [self setLevel:NSNormalWindowLevel];
+                [super toggleFullScreen:nil];
+            }
+        }
+        else if (nativeFullscreenAuto && !wants)
+        {
+            ERR(@"NativeFullscreen: leaving the Space of %@\n", self);
+            nativeFullscreenExitRequested = TRUE;
+            [super toggleFullScreen:nil];
+        }
+    }
